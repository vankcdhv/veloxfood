# Dev mặc định: dùng Next.js rewrites trong next.config.ts proxy /api/* → backend.
# Không cần set gì cho local nếu backend ở localhost:8080.

# Override backend URL cho rewrites (server-side, build time):
# BACKEND_API_URL=http://localhost:8080

# Override API base cho axios (client-side) — chỉ dùng khi frontend deploy tách backend
# và bỏ rewrites (gọi cross-origin có CORS):
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# ── Phase D: Review / Reporting / Notification service URLs ──
# REVIEW_API_URL=http://localhost:8087
# REPORTING_API_URL=http://localhost:8088
# NOTIFICATION_API_URL=http://localhost:8089

# ── Firebase (optional — để trống để tắt push notifications & Firestore realtime tracking) ──
# Chạy `pnpm add firebase` trước khi bật các biến này.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# VAPID key: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
