!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
package-lock.json
yarn.lock
pnpm-lock.yaml

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

# screenshots / ảnh chụp màn hình
screenshots/
docs/screenshots/

# Tài liệu nội bộ chứa thông tin nhạy cảm — không commit
/docs/

# logs & cache
logs.txt
__pycache__
.cache
.run-logs/

# editor
.idea

# external repos dùng để tham khảo
external/

# git worktrees (chỉ dùng local)
worktrees/
